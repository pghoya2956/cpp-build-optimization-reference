# syntax=docker/dockerfile:1
#
# Dockerfile.ablation — the measurement image. One parameterized Dockerfile
# drives every ablation cell (see docs/measurement-methodology.md and
# bench/cells.tsv). A cell's six technique toggles plus the variant flags
# arrive as build ARGs; bench/measure-cell.sh resolves a cell ID into them.
#
# Kept separate from docker/Dockerfile.optimized (the deployable image): the
# layer-B timing markers and the install-everything toolchain belong only to
# measurement, not to the shipped artifact.

# ---------------------------------------------------------------- builder ---
FROM nvidia/cuda:12.2.2-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# layer A — the full measurement toolchain. Every tool is installed regardless
# of the cell, so any cell can toggle any technique; sccache is fetched from the
# upstream release (not in the ubuntu 22.04 archive). The dependency manifest is
# COPYd before the source, so a source edit never busts this layer. apt is
# served from a BuildKit cache mount. This whole RUN is the layer-A measurement
# boundary — one step, parsed from the buildx '#N DONE' timestamp.
ARG SCCACHE_VERSION=0.15.0
COPY docker/apt-packages-ablation.txt /tmp/apt-packages.txt
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update \
 && grep -v '^#' /tmp/apt-packages.txt | xargs apt-get install -y --no-install-recommends \
 && arch="$(dpkg --print-architecture)" \
 && case "$arch" in amd64) sa=x86_64 ;; arm64) sa=aarch64 ;; *) sa=x86_64 ;; esac \
 && curl -fsSL "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/sccache-v${SCCACHE_VERSION}-${sa}-unknown-linux-musl.tar.gz" \
      | tar -xz -C /tmp \
 && install -m755 "/tmp/sccache-v${SCCACHE_VERSION}-${sa}-unknown-linux-musl/sccache" /usr/local/bin/sccache \
 && rm -rf /tmp/sccache-v*

# ccache configured to avoid the three classic cache-miss traps —
# see docs/ccache-cache-miss-traps.md.
ENV CCACHE_DIR=/ccache \
    CCACHE_BASEDIR=/workspace \
    CCACHE_COMPILERCHECK=content \
    CCACHE_SLOPPINESS=time_macros,pch_defines

# --- ablation cell parameters ----------------------------------------------
# bench/measure-cell.sh fills these from a row of bench/cells.tsv. The defaults
# are cell A0 (baseline — every technique off). Declared after layer A so a
# parameter change never invalidates the toolchain layer.
ARG ABL_GENERATOR="Unix Makefiles"
ARG ABL_CXX_LAUNCHER=""
ARG ABL_CUDA_LAUNCHER=""
ARG ABL_PCH_DISABLED="ON"
ARG ABL_UNITY="OFF"
ARG ABL_CXX_FLAGS=""
ARG ABL_MOLD="0"
ARG ABL_SPLIT_LIBS="none"
ARG ABL_SPLIT_LIB_COUNT="16"
ENV ABL_GENERATOR="${ABL_GENERATOR}" \
    ABL_CXX_LAUNCHER="${ABL_CXX_LAUNCHER}" \
    ABL_CUDA_LAUNCHER="${ABL_CUDA_LAUNCHER}" \
    ABL_PCH_DISABLED="${ABL_PCH_DISABLED}" \
    ABL_UNITY="${ABL_UNITY}" \
    ABL_CXX_FLAGS="${ABL_CXX_FLAGS}" \
    ABL_MOLD="${ABL_MOLD}" \
    ABL_SPLIT_LIBS="${ABL_SPLIT_LIBS}" \
    ABL_SPLIT_LIB_COUNT="${ABL_SPLIT_LIB_COUNT}"

# Source COPYd last — only this layer and the build below rebuild on a code edit.
COPY CMakeLists.txt CMakePresets.json /workspace/
COPY cmake/ /workspace/cmake/
COPY src/ /workspace/src/
COPY bench/measure-build.sh /workspace/bench/measure-build.sh

# layer B — the measured build. measure-build.sh wraps `cmake --build` in date
# markers and prints LAYER_B_SECONDS=. The ccache cache mount lets a warm build
# reuse the compiler cache. The full GitHub Actions environment is mounted as
# one secret (not required): present only for the sccache cache-backend cell.
RUN --mount=type=cache,target=/ccache \
    --mount=type=secret,id=gha_env \
    bash bench/measure-build.sh

# ---------------------------------------------------------------- runtime ---
# layer C — the final image is cuda:*-runtime (~1 GB) instead of cuda:*-devel
# (~3.5 GB). Only the executable is copied out of the builder stage.
FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04 AS runtime
WORKDIR /app
COPY --from=builder /workspace/build/ablation/cbor /app/cbor
CMD ["./cbor"]
