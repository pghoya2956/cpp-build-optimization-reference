# syntax=docker/dockerfile:1
#
# Dockerfile.optimized — the "after" image. The full build-optimization stack is
# applied here; compare every line against docker/Dockerfile.baseline.
#
#   layer A (container)   multi-stage build, dependency layer above source COPY,
#                         BuildKit cache mounts for apt and ccache
#   layer B (compile)     Ninja, ccache, mold linker, split DWARF, unity build,
#                         PCH, Ninja job pools  (see CMakePresets.json "optimized")
#   layer C (image size)  final stage on cuda:*-runtime, not cuda:*-devel; only
#                         the binary leaves the builder
#
# Build with BuildKit (docker buildx) so the --mount=type=cache mounts take effect.

# ---------------------------------------------------------------- builder ---
FROM nvidia/cuda:12.2.2-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# layer A — the dependency manifest is COPYd and installed before any source, so
# editing source never invalidates this layer. apt is served from a BuildKit
# cache mount, so packages are not re-downloaded across builds. This mirrors how
# ROS Navigation2 copies package.xml manifests first (docs/reference-analysis.md).
COPY docker/apt-packages.txt /tmp/apt-packages.txt
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update \
 && grep -v '^#' /tmp/apt-packages.txt | xargs apt-get install -y --no-install-recommends

# ccache configured to avoid the three classic cache-miss traps — see
# docs/ccache-cache-miss-traps.md for what each setting fixes.
ENV CCACHE_DIR=/ccache \
    CCACHE_BASEDIR=/workspace \
    CCACHE_COMPILERCHECK=content \
    CCACHE_SLOPPINESS=time_macros,pch_defines

# Source COPYd last — only this layer and the build below rebuild on a code edit.
COPY CMakeLists.txt CMakePresets.json /workspace/
COPY cmake/ /workspace/cmake/
COPY src/ /workspace/src/

# layer B — Ninja build routed through ccache (compiler launcher) with unity
# build, PCH and split DWARF from the "optimized" preset. `mold -run` redirects
# every linker invocation to mold; it works with any compiler, unlike
# -fuse-ld=mold which needs GCC >= 12.1 (this image ships GCC 11). ccache lives
# in a cache mount, so a warm build reuses the compiler cache.
RUN --mount=type=cache,target=/ccache \
    cmake --preset optimized \
 && mold -run cmake --build build/optimized \
 && ccache --show-stats

# ---------------------------------------------------------------- runtime ---
# layer C — the final image is cuda:*-runtime (~1 GB) instead of cuda:*-devel
# (~3.5 GB). Only the executable is copied out; the dev toolchain, the build
# tree and the split-DWARF .dwo files all stay behind in the builder stage.
FROM nvidia/cuda:12.2.2-runtime-ubuntu22.04 AS runtime

WORKDIR /app
COPY --from=builder /workspace/build/optimized/cbor /app/cbor

CMD ["./cbor"]
